# Application configuration
DATABASE_URL=postgresql://stackuser:changeme@localhost:5432/botdb
REDIS_URL=redis://localhost:6379/1
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE=teste-aprendizado
META_TOKEN=change-me
META_PHONE_NUMBER_ID=1234567890123456
META_BUSINESS_ID=123456789012345

# IMPORTANTE: as variáveis abaixo (Meta, palavra de ativação, lembretes e IA) só valem
# como valor INICIAL — na primeira vez que o bot lê a configuração, ele copia esses
# valores para a tabela configuracao_sistema e passa a usar o banco a partir daí.
# Depois do primeiro boot, edite tudo isso em /admin/configuracoes; mudar aqui e
# reiniciar o processo NÃO tem mais efeito. Ver seção "Configurações pelo painel" no readme.md.

# Lembrete automático de agendamento (exige template aprovado no Meta Business Manager, ver readme.md)
META_TEMPLATE_LEMBRETE_NOME=lembrete_agendamento
META_TEMPLATE_LEMBRETE_IDIOMA=pt_BR
LEMBRETE_ANTECEDENCIA_HORAS=24
LEMBRETE_INTERVALO_MINUTOS=15

# Camada de IA (NLU) - desligada por padrão (AI_ENABLED=false), zero impacto se não configurada.
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SEGUNDOS=6.0
AI_CACHE_TTL_SEGUNDOS=600
ADMIN_USERNAME=admin
# Required: generate strong values with openssl rand -hex 32 and never copy the examples literally.
ADMIN_PASSWORD=
SESSION_SECRET_KEY=

# Operational defaults used by helper scripts and the conversation flow
# BOT_ACTIVATION_WORDS também é só valor inicial — editável em /admin/configuracoes depois do primeiro boot.
BOT_ACTIVATION_WORDS=oibot
SEED_EMPRESA_SLUG=sorriso-feliz
SEED_EMPRESA_NOME=Clínica Sorriso Feliz
SEED_EMPRESA_SEGMENTO=clinica
SEED_EMPRESA_TELEFONE_WHATSAPP=5586999999999
SEED_EMPRESA_EVOLUTION_INSTANCE=teste-aprendizado