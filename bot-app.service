[Unit]
Description=Bot WhatsApp FastAPI (Docker)
After=docker.service network.target
Requires=docker.service

[Service]
User=wadson
WorkingDirectory=/home/wadson/stack/bot-app
ExecStart=/usr/bin/docker compose up --build bot-app
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target